<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The editor's HTTP API and hosting code, shared by the web project (dotnet run, port 5080)
    and the Windows desktop app. The frontend in ../AlbionSaveEditor/wwwroot is embedded so a
    single-file build works without any files next to it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AlbionSaveEditor</RootNamespace>
    <Version>1.0.0</Version>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- frontend (owned by the frontend developer) embedded under "wwwroot/..." -->
    <EmbeddedResource Include="..\AlbionSaveEditor\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="LICENSE-AlbLib.txt" LogicalName="LICENSE-AlbLib.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlbLib.Core\AlbLib.Core.csproj" />
  </ItemGroup>

</Project>
