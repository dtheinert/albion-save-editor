<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows desktop shell: hosts the editor server in-process on 127.0.0.1 (random port) and shows the
    UI in a WebView2 window. Publish as a single self-contained exe with ../../publish.ps1.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AlbionSaveEditor.Desktop</RootNamespace>
    <AssemblyName>AlbionSaveEditor.Desktop</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>Albion Save Editor</Product>
    <!-- do not ship the WebView2 package XML docs next to the exe -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <AssemblyTitle>Albion Save Editor</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlbionSaveEditor.Server\AlbionSaveEditor.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- The WebView2 package also references its WPF control; we only use WinForms. Dropping it avoids
       a WindowsBase version conflict (MSB3277) and keeps the published exe smaller. -->
  <Target Name="RemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
